<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
The antiphon bridge as a launchd user agent (macOS).

`install.sh install` fills the placeholders and does the rest. By hand:

  sed -e "s|@ANTIPHON@|$(command -v antiphon)|" -e "s|@PATH@|$PATH|" -e "s|@LOG@|$HOME/.antiphon/log|" -e "/@ENVIRONMENT@/d" \
      contrib/com.antiphon.bridge.plist > ~/Library/LaunchAgents/com.antiphon.bridge.plist
  launchctl load ~/Library/LaunchAgents/com.antiphon.bridge.plist

Remove with:

  launchctl unload ~/Library/LaunchAgents/com.antiphon.bridge.plist
  rm ~/Library/LaunchAgents/com.antiphon.bridge.plist

@PATH@ must reach `codex`, which the bridge runs to start the app-server daemon. When
CLAUDE_CONFIG_DIR, CODEX_HOME or ANTIPHON_HOME is set for your sessions, add a
key/string pair for each under EnvironmentVariables. The log directory exists once the
bridge has run once; until then launchd starts the job without the redirection.
KeepAlive restarts a crash only: a bridge that finds another one already answering
exits 0 and stays stopped.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.antiphon.bridge</string>
    <key>ProgramArguments</key>
    <array>
        <string>@ANTIPHON@</string>
        <string>bridge</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>@PATH@</string>
@ENVIRONMENT@
    </dict>
    <key>StandardOutPath</key>
    <string>@LOG@/bridge.out</string>
    <key>StandardErrorPath</key>
    <string>@LOG@/bridge.out</string>
</dict>
</plist>
